<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tm_web_bridge</name>
  <version>0.1.0</version>
  <description>웹 GUI(TRobotics_Client) ↔ TM Robot 하이브리드 브리지: FastAPI(/jog, /robot/status)가 기존 tm_task_manager 서비스를 재사용한다.</description>
  <maintainer email="kukwonko@gmail.com">TM Robot Team</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tm_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tm_task_manager</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
