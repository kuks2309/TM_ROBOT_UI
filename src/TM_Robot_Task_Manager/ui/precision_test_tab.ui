          </property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="radioButton_datasetCorrected">
          <property name="text">
           <string>corrected</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
          <property name="toolTip">
           <string>jig 번호가 홀수=긴 변 규칙으로 정규화된 보정본</string>
          </property>
