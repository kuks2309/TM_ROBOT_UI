   <!-- ===== 신규 블록 A: 저장 데이터 정밀도 분석 (plate_pose_calc) ===== -->
   <item>
    <widget class="QGroupBox" name="groupBox_plateDataset">
     <property name="title">
      <string>저장 데이터 정밀도 분석 (plate_pose_calc)</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_plateDataset">
      <item>
       <layout class="QHBoxLayout" name="horizontalLayout_datasetControls">
        <item>
         <widget class="QLabel" name="label_plateFolder">
