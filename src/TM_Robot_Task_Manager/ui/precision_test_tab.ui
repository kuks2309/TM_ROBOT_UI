<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PrecisionTestTab</class>
 <widget class="QWidget" name="PrecisionTestTab">
  <layout class="QVBoxLayout" name="verticalLayout_main">
   <item>
    <widget class="QScrollArea" name="scrollArea_precision">
     <property name="widgetResizable">
      <bool>true</bool>
     </property>
     <widget class="QWidget" name="scrollAreaWidgetContents">
      <layout class="QVBoxLayout" name="verticalLayout_scroll">
   <!-- 테스트 설정 -->
   <item>
    <widget class="QGroupBox" name="groupBox_testSettings">
     <property name="title">
      <string>테스트 설정</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_testSettings">
      <!-- 테스트 설정 한 줄로 -->
      <item>
       <layout class="QHBoxLayout" name="horizontalLayout_allSettings">
        <item>
         <widget class="QRadioButton" name="radioButton_staticTest">
          <property name="text">
           <string>정적 테스트</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="radioButton_dynamicTest">
          <property name="text">
           <string>동적 테스트</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="label_iterations">
          <property name="text">
           <string>반복 횟수:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="spinBox_iterations">
          <property name="minimum">
           <number>1</number>
          </property>
          <property name="maximum">
           <number>1000</number>
          </property>
          <property name="value">
           <number>50</number>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="label_iterationsUnit">
          <property name="text">
           <string>회</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="checkBox_autoSave">
          <property name="text">
           <string>자동 저장</string>
          </property>
          <property name="checked">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <!-- 동적 테스트 설정 (Recipe 표시) -->
        <item>
         <widget class="QWidget" name="widget_dynamicSettings">
          <layout class="QHBoxLayout" name="horizontalLayout_dynamicSettings">
           <property name="leftMargin">
            <number>10</number>
           </property>
           <property name="topMargin">
            <number>0</number>
           </property>
           <property name="rightMargin">
            <number>0</number>
           </property>
           <property name="bottomMargin">
            <number>0</number>
           </property>
           <item>
            <widget class="QLabel" name="label_recipeLabel">
             <property name="text">
              <string>Recipe:</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="label_currentRecipe">
             <property name="text">
              <string>(로드된 Recipe 없음)</string>
             </property>
             <property name="styleSheet">
              <string>color: #666; font-style: italic;</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <spacer name="horizontalSpacer_settings">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>

      <!-- 제어 버튼 -->
      <item>
       <layout class="QHBoxLayout" name="horizontalLayout_controls">
        <item>
         <widget class="QPushButton" name="pushButton_startTest">
          <property name="text">
           <string>테스트 시작</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="pushButton_stopTest">
          <property name="text">
           <string>중지</string>
          </property>
          <property name="enabled">
           <bool>false</bool>
