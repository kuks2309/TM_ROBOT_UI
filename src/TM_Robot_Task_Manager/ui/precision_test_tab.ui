         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="pushButton_resetTest">
          <property name="text">
           <string>초기화</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>

      <!-- 진행 상황 -->
      <item>
       <layout class="QVBoxLayout" name="verticalLayout_progress">
        <item>
         <widget class="QLabel" name="label_progress">
          <property name="text">
