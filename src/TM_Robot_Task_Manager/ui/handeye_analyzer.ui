<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>HandEyeAnalyzerWindow</class>
 <widget class="QWidget" name="HandEyeAnalyzerWindow">
  <property name="minimumSize">
   <size>
    <width>1200</width>
    <height>800</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>Hand-Eye Calibration Analyzer</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_main">
   <!-- 상단: 파일 열기 -->
   <item>
    <widget class="QGroupBox" name="groupBox_file">
     <property name="title">
      <string>데이터 파일</string>
     </property>
     <layout class="QHBoxLayout" name="horizontalLayout_file">
      <item>
       <widget class="QPushButton" name="pushButton_openFile">
        <property name="text">
         <string>CSV 열기</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="pushButton_recentFile">
        <property name="text">
         <string>최근 파일</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="label_fileName">
        <property name="text">
         <string>파일을 선택하세요</string>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="horizontalSpacer_file">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size>
          <width>40</width>
          <height>20</height>
         </size>
        </property>
       </spacer>
      </item>
      <item>
       <widget class="QPushButton" name="pushButton_exportReport">
        <property name="text">
         <string>리포트 내보내기</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="pushButton_saveGraphs">
        <property name="text">
         <string>그래프 저장</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- 탭 위젯 -->
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>

     <!-- Tab 1: 개요 -->
     <widget class="QWidget" name="tab_overview">
      <attribute name="title">
       <string>개요</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_overview">
