                <bool>true</bool>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
      <!-- 탭 5: 설정 -->
      <widget class="QWidget" name="tab_settings">
       <attribute name="title">
        <string>설정</string>
       </attribute>
       <layout class="QHBoxLayout" name="horizontalLayout_settings">
        <!-- TF 발행 설정 -->
        <item>
         <widget class="QGroupBox" name="groupBox_tfPublish">
          <property name="title">
           <string>TF 발행 설정</string>
          </property>
          <layout class="QVBoxLayout" name="verticalLayout_tfPublish">
           <item>
            <widget class="QCheckBox" name="checkBox_enableTF">
             <property name="text">
              <string>TF 발행 활성화</string>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="horizontalLayout_tfInterval">
             <item>
              <widget class="QLabel" name="label_tfInterval">
               <property name="text">
                <string>발행 주기 (초):</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QDoubleSpinBox" name="doubleSpinBox_tfInterval">
               <property name="minimum">
                <double>0.100000000000000</double>
               </property>
               <property name="maximum">
                <double>10.000000000000000</double>
               </property>
               <property name="singleStep">
                <double>0.100000000000000</double>
               </property>
               <property name="value">
                <double>1.000000000000000</double>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QLabel" name="label_tfStatus">
             <property name="text">
              <string>상태: 비활성</string>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="verticalSpacer_tfPublish">
             <property name="orientation">
              <enum>Qt::Vertical</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>20</width>
               <height>40</height>
              </size>
             </property>
            </spacer>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <spacer name="horizontalSpacer_settings">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>
      <!-- 탭 5: 글로벌 변수 -->
      <widget class="QWidget" name="tab_globalVariables">
       <attribute name="title">
        <string>글로벌 변수</string>
       </attribute>
       <layout class="QVBoxLayout" name="verticalLayout_globalVariables">
        <item>
         <widget class="QGroupBox" name="groupBox_variableControl">
          <property name="title">
           <string>글로벌 변수 읽기/쓰기</string>
          </property>
          <layout class="QVBoxLayout" name="verticalLayout_variableControl">
           <!-- 변수 이름 선택 -->
           <item>
            <layout class="QHBoxLayout" name="horizontalLayout_variableName">
             <item>
              <widget class="QLabel" name="label_variableName">
               <property name="text">
                <string>변수 이름:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QComboBox" name="comboBox_variableName">
               <property name="editable">
                <bool>true</bool>
               </property>
               <property name="minimumSize">
                <size>
                 <width>200</width>
                 <height>0</height>
                </size>
               </property>
               <property name="sizePolicy">
                <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
                 <horstretch>0</horstretch>
                 <verstretch>0</verstretch>
                </sizepolicy>
               </property>
               <item>
                <property name="text">
                 <string>g_robot_command</string>
                </property>
               </item>
               <item>
                <property name="text">
                 <string>g_TM_Landmark</string>
                </property>
               </item>
               <item>
                <property name="text">
                 <string>g_tm_landmark_detect</string>
                </property>
               </item>
               <item>
                <property name="text">
                 <string>g_jig_landmark1_detect</string>
                </property>
               </item>
               <item>
                <property name="text">
                 <string>g_jig_landmark2_detect</string>
                </property>
               </item>
               <item>
                <property name="text">
                 <string>g_jig_landmark3_detect</string>
                </property>
               </item>
               <item>
                <property name="text">
                 <string>g_jig_landmark4_detect</string>
                </property>
               </item>
               <item>
                <property name="text">
                 <string>g_Jig_Landmark1</string>
                </property>
               </item>
               <item>
                <property name="text">
                 <string>g_Jig_Landmark2</string>
                </property>
               </item>
               <item>
                <property name="text">
                 <string>g_Jig_Landmark3</string>
                </property>
               </item>
               <item>
                <property name="text">
                 <string>g_Jig_Landmark4</string>
                </property>
               </item>
              </widget>
             </item>
             <item>
              <spacer name="horizontalSpacer_variableName">
               <property name="orientation">
                <enum>Qt::Horizontal</enum>
               </property>
               <property name="sizeHint" stdset="0">
                <size>
                 <width>40</width>
                 <height>20</height>
                </size>
               </property>
              </spacer>
             </item>
            </layout>
           </item>
           <!-- 변수 값 입력 -->
           <item>
            <layout class="QHBoxLayout" name="horizontalLayout_variableValue">
             <item>
              <widget class="QLabel" name="label_variableValue">
               <property name="text">
                <string>변수 값:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLineEdit" name="lineEdit_variableValue">
               <property name="placeholderText">
                <string>값 입력 또는 읽기 결과</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <!-- 버튼들 -->
           <item>
            <layout class="QHBoxLayout" name="horizontalLayout_variableButtons">
             <item>
              <widget class="QPushButton" name="pushButton_readVariable">
               <property name="text">
                <string>읽기</string>
               </property>
               <property name="minimumSize">
                <size>
                 <width>100</width>
                 <height>30</height>
                </size>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="pushButton_writeVariable">
               <property name="text">
                <string>쓰기</string>
               </property>
               <property name="minimumSize">
                <size>
                 <width>100</width>
                 <height>30</height>
                </size>
               </property>
              </widget>
             </item>
             <item>
              <spacer name="horizontalSpacer_variableButtons">
               <property name="orientation">
                <enum>Qt::Horizontal</enum>
               </property>
               <property name="sizeHint" stdset="0">
                <size>
                 <width>40</width>
                 <height>20</height>
                </size>
               </property>
              </spacer>
             </item>
            </layout>
           </item>
           <!-- 상태 표시 -->
           <item>
            <widget class="QLabel" name="label_variableStatus">
             <property name="text">
              <string>상태: 대기 중</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <!-- 변수 히스토리 -->
        <item>
         <widget class="QGroupBox" name="groupBox_variableHistory">
          <property name="title">
           <string>변수 히스토리</string>
          </property>
          <layout class="QVBoxLayout" name="verticalLayout_variableHistory">
           <item>
            <widget class="QTableWidget" name="tableWidget_variableHistory">
             <property name="columnCount">
              <number>3</number>
             </property>
             <column>
