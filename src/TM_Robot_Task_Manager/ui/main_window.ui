           </item>
           <item>
            <widget class="QPushButton" name="pushButton_clearHistory">
             <property name="text">
              <string>히스토리 지우기</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>
      <!-- 탭 6: 정밀도 테스트 -->
      <widget class="QWidget" name="tab_precisionTest">
       <attribute name="title">
