<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tm20">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import tm20 urdf file (실물 보정 모델; nominal 은 tm20.urdf.xacro) -->
    <xacro:include filename="$(find tm_description)/xacro/tm20-calib.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="tm20.ros2_control.xacro" />


    <xacro:tm20_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
