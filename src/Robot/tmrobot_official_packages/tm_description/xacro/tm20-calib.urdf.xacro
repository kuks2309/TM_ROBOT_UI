<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tm20">
  <!-- ARGUMENTS -->
  <xacro:arg name="ns" default="" />
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="color" default="none" />
  <xacro:arg name="trans_hw_iface" default="hardware_interface/PositionJointInterface" />

  <xacro:include filename="$(find tm_description)/xacro/macro.gazebo.xacro" />
  <xacro:include filename="$(find tm_description)/xacro/macro.transmission.xacro" />
  <xacro:include filename="$(find tm_description)/xacro/macro.materials.xacro" />


  <!-- Import TM Cobot: tm20 robot description file -->
  <!-- 실물 로봇(169.254.122.16)의 DHTable + DeltaDH 를 tm_mod_urdf 로 반영한 보정 모델. -->
  <!-- nominal 로 되돌리려면 tm20.urdf.xacro 를 대신 include 한다. -->
  <xacro:include filename="$(find tm_description)/xacro/macro.tm20-calib.urdf.xacro" />


  <!--  -->
  <xacro:tmr_gazebo ns="$(arg ns)" prefix="$(arg prefix)" />
  <xacro:tmr_transmission prefix="$(arg prefix)" hw_iface="$(arg trans_hw_iface)" />


  <!-- Import TM Cobot: mesh.color.default -->
  <xacro:property name="color" value="$(arg color)"/>
  <xacro:if value="${color == 'none'}">
    <xacro:tm20 ns="$(arg ns)" prefix="$(arg prefix)" color="emeraldgreen" format="obj"/>
  </xacro:if>


  <!-- Import TM Cobot: mesh.color.specific-->
  <xacro:unless value="${color == 'none'}">
    <xacro:tm20 ns="$(arg ns)" prefix="$(arg prefix)" color="${color}" format="obj" />
  </xacro:unless>


</robot>
